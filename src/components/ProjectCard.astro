---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card" data-reveal>
  <a
    class="project-card__media"
    href={project.liveUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Abrir projeto ${project.name}`}
  >
    <img
      src={project.previewSrc}
      alt={project.previewAlt}
      width="960"
      height="600"
      loading="lazy"
      decoding="async"
      onerror="this.onerror=null;this.src='/previews/placeholder.svg';this.classList.add('is-fallback')"
    />
  </a>
  <div class="project-card__body">
    <h3 class="project-card__title">{project.name}</h3>
    <p class="project-card__summary">{project.summary}</p>
    <a
      class="btn btn--ghost project-card__cta"
      href={project.liveUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      Ver projeto
    </a>
  </div>
</article>

<style>
  .project-card {
    display: grid;
    gap: 1.25rem;
    opacity: 1;
    transform: none;
    transition:
      opacity 480ms var(--ease-out),
      transform 480ms var(--ease-out),
      border-color 150ms var(--ease-out);
  }

  .project-card.is-reveal-pending {
    opacity: 0;
    transform: translateY(12px);
  }

  .project-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .project-card__media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-muted);
    transition: border-color 150ms var(--ease-out);
  }

  .project-card__media:hover {
    border-color: var(--signal);
  }

  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .project-card__media img.is-fallback {
    object-fit: contain;
    object-position: center;
    padding: 1.5rem;
  }

  .project-card__title {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .project-card__summary {
    margin: 0 0 1.1rem;
    color: var(--ink-muted);
  }

  .project-card__cta {
    width: fit-content;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card.is-reveal-pending {
      opacity: 1;
      transform: none;
      transition: border-color 150ms var(--ease-out);
    }
  }
</style>
